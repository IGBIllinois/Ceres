#include "winver.h"

IDI_ICON1               ICON    DISCARDABLE     "Icons/ripe.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @Ceres_VERSION_MAJOR@,@Ceres_VERSION_MINOR@,@Ceres_VERSION_PATCH@,@Ceres_VERSION_TWEAK@
 PRODUCTVERSION @Ceres_VERSION_MAJOR@,@Ceres_VERSION_MINOR@,@Ceres_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x00040004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "University of Illinois at Urbana-Champaign"
            VALUE "FileDescription", "Ceres Data Acquisition Software"
            VALUE "FileVersion", "@Ceres_VERSION_MAJOR@.@Ceres_VERSION_MINOR@.@Ceres_VERSION_PATCH@.@Ceres_VERSION_TWEAK@\0"
            VALUE "LegalCopyright", "Copyright (C) 2021..2026 UIUC"
            VALUE "InternalName", "Ceres"
            VALUE "OriginalFilename", "Ceres.exe"
            VALUE "ProductName", "Ceres"
            VALUE "ProductVersion", "@Ceres_VERSION_MAJOR@.@Ceres_VERSION_MINOR@.@Ceres_VERSION_PATCH@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
