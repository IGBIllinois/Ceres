#include "winver.h"

// note that the icon used by the Explorer (i.e. the programs icon) is the
// first icon in the executable and the icons are sorted both by their order
// and alphabetically (!), so put this icon first and give it a name
// starting with "a"
aaaaaaaa ICON "Icons/ripe.ico"

// this icon is used with wxFrame::SetIcon()
RappFieldMapper ICON "Icons/ripe.ico"


VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGS 0x0L
 FILEFLAGSMASK 0x3fL
 FILEOS 0x00040004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "University of Illinois at Urbana-Champaign"
            VALUE "FileDescription", "Ceres Field Mapper"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "LegalCopyright", "Copyright (C) 2026 UIUC"
            VALUE "InternalName", "CeresFieldMapper"
            VALUE "OriginalFilename", "CeresFieldMapper.exe"
            VALUE "ProductName", "CeresFieldMapper"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END

